# Copy this file to .env and fill in your values before running the server.

# Required: Get a free API key at https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY="YOUR KEY GOES HERE"

# Optional — leave as-is for local development
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
